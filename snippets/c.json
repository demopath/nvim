{
  "for+": {
    "prefix": "for+",
    "body": ["for(int ${1:i}=0; ${1:i}<${2:3}; ${1:i}++) {", "\t$0", "}"]
  },
  "for-": {
    "prefix": "for-",
    "body": ["for(int ${1:i}=0; ${1:i}<${2:3}; ${1:i}--) {", "\t$0", "}"]
  },
